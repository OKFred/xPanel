{
  "name": "xpanel",
  "version": "3.0.1",
  "private": true,
  "description": "A local-first Manifest V3 API workbench for standalone and Chrome DevTools use.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:extension",
    "build:extension": "pnpm build:packages && pnpm --filter @xpanel/extension build",
    "build:packages": "pnpm --filter @xpanel/contracts build && pnpm --filter @xpanel/request-core build",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:store": "pnpm assets:brand && pnpm build:extension && node scripts/e2e-chromium.mjs --store-assets",
    "assets:verify": "node scripts/verify-store-assets.mjs",
    "listing:verify": "node scripts/verify-store-listing.mjs",
    "e2e:chromium": "pnpm build:extension && node scripts/e2e-chromium.mjs",
    "e2e:upgrade": "node scripts/e2e-extension-upgrade.mjs && node scripts/e2e-extension-upgrade.mjs --baseline-3.0",
    "audit:static": "node scripts/static-audit.mjs",
    "audit:upgrade": "node scripts/verify-extension-upgrade.mjs && node --test scripts/verify-extension-upgrade.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:upgrade && pnpm audit:static && pnpm assets:verify && pnpm listing:verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm build:packages && eslint .",
    "release:prepare": "pnpm check && pnpm e2e:chromium && pnpm e2e:upgrade && pnpm --filter @xpanel/extension zip && pnpm sbom:extension && node scripts/prepare-release.mjs",
    "sbom:extension": "pnpm --filter @xpanel/extension sbom --sbom-format cyclonedx --sbom-spec-version 1.6 --prod --lockfile-only | node scripts/record-sbom.mjs",
    "test": "pnpm build:packages && pnpm -r --if-present test && pnpm test:tooling",
    "test:tooling": "node --test scripts/dependency-policy.test.mjs scripts/import-dependency-security.test.mjs scripts/e2e/service-readiness.test.mjs scripts/e2e/cloudflare-target-config.test.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.4.0",
    "fflate": "0.8.3",
    "prettier": "3.6.2",
    "sharp": "0.35.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0"
  }
}
