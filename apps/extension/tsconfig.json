{
  "extends": ["../../tsconfig.base.json", "./.wxt/tsconfig.json"],
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".wxt/wxt.d.ts",
    "*.config.ts",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.vue",
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts"
  ]
}
