{
  "name": "@xpanel/native-host",
  "version": "2.0.0",
  "private": true,
  "description": "Secure native messaging companion for xPanel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xpanel-native-host": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/bundle.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "diagnose": "node dist/index.js diagnose",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xpanel/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
